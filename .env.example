# GEMINI_API_KEY: Required for Gemini AI Career Studio calls on the backend.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this application is hosted.
APP_URL="http://localhost:3000"

# Cloud SQL PostgreSQL connection settings (injected in AI Studio / Cloud Run)
SQL_HOST="/cloudsql/instance-connection-name"
SQL_DB_NAME="resumind"
SQL_USER="resumind_app"
SQL_PASSWORD="CHANGE_ME"
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="CHANGE_ME"

# Optional email allowed to bootstrap the initial SuperAdmin role upon verified Google Sign-In
SUPERADMIN_EMAIL=""
